model OwnershipTransfer {
  id              String         @id @default(uuid())
  transferCode    String         @unique
  
  canineId        String?        
  canine          Canine?        @relation("CanineTransfers", fields: [canineId], references: [id])

  litterId        String?
  litter          Litter?        @relation("LitterTransfers", fields: [litterId], references: [id])

  currentOwnerId  String
  currentOwner    User           @relation("SentTransfers", fields: [currentOwnerId], references: [id])

  requests            TransferRequest[]

  newOwnerId      String?        
  newOwner        User?          @relation("ReceivedTransfers", fields: [newOwnerId], references: [id])

  status          TransferOwnershipStatus @default(PENDING)

  isVerified  Boolean                 @default(false)
  verifiedAt  DateTime?

  expiresAt       DateTime     
  
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([transferCode])
  @@index([status])
  @@map("ownership_transfers")
}

enum TransferOwnershipStatus {
  PENDING
  APPROVE 
  DECLINE
}

model TransferRequest {
  id                 String            @id @default(uuid())
  transferId         String
  transfer           OwnershipTransfer @relation(fields: [transferId], references: [id], onDelete: Cascade)
  isAccepted  Boolean           @default(false)
  
  userId             String
  user               User              @relation(fields: [userId], references: [id])

  createdAt          DateTime          @default(now())

  @@unique([transferId, userId]) // Jate ekjon user ekta transfer-e bar bar request na korte pare
  @@map("transfer_requests")
}