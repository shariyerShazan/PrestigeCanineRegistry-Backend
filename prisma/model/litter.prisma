model Litter {
  id                String            @id @default(uuid())
  pcrId             String            @unique // e.g., PCR-L301-F1B-00001-564738
  
  // ID Components
  pcrPrefix         String            @default("L")
  pcrBreedCode      String            
  generation        String            // Parents theke auto-calculate hoye ekhane boshibe
  pcrIncremental    String            
  pcrRandom         String            
  tier              RegistryTier      @default(BLUE)
  
  breedId           String
  breedRelation     Breed             @relation(fields: [breedId], references: [id])

  name              String?           // Optional: Litter Name (e.g., "A-Litter")
  dateOfBirth       DateTime

  // Location (Common for the whole group)
  city              String
  state             String
  zipCode           String
  country           String

  // Parent Relations (Manual linkage or PCR verified)
  motherPcrId       String?
  mother            Canine?           @relation("MotherRelation", fields: [motherPcrId], references: [pcrId])
  fatherPcrId       String?
  father            Canine?           @relation("FatherRelation", fields: [fatherPcrId], references: [pcrId])

  // Logic: Parents verified hole true hobe (No DNA needed for pups)
  isAutoDNAVerified Boolean           @default(false) 

  // Owner Relation (Breeder/Current Owner)
  ownerId           String
  owner             User              @relation("LitterOwner", fields: [ownerId], references: [id])

  // One-to-Many: Multiple puppies in one litter
  puppies           Canine[]          @relation("LitterPuppies")

  // System Relations
  images            Image[]           @relation("LitterImages")
  DNAdocuments      Document[]        @relation("LitterDocuments")
  healthRequests    CanineHealthRequest[] @relation("LitterHealthRequests")
  reports           Report[]          @relation("LitterReports")
  certificateRequests CertificateRequest[] @relation("LitterCertRequests") 
  transfers         OwnershipTransfer[] @relation("LitterTransfers")

  status            CanineStatus      @default(PENDING)
  requestType       RegistrationRequestType @default(LITTER_REGISTRATION)
  assignedTier      VerificationType  @default(NONE)

  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  @@map("litters")
}


enum RegistrationRequestType {
  NEW_REGISTRATION
  LITTER_REGISTRATION
  TRANSFER_REGISTRATION
}