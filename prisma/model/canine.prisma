model Canine {
  id                String            @id @default(uuid())
  pcrId             String            @unique // e.g., PCR-G301-00001-123456
  
  // Visibility Logic
  isPublicProfile   Boolean           @default(false) // FALSE till transfer/reg
  hasPedigreeAgreement Boolean        @default(false) // Checkbox for OTTC

  // ID Components
  pcrPrefix         String            // 'G' or 'B'
  pcrBreedCode      String            
  generation        String?           
  pcrIncremental    String            
  pcrRandom         String            
  tier              RegistryTier      @default(BLUE)
  
  breedId           String
  breedRelation     Breed             @relation(fields: [breedId], references: [id])

  name              String            // Puppy's name
  gender            Gender
  dateOfBirth       DateTime          // Inherited from Litter
  color             String
  weight            Float
  microchipId       String?           @unique

  // Location (Initially inherited from Litter, can be updated)
  city              String
  state             String
  zipCode           String
  country           String

  // DNA & Health
  primaryBreedDNA   String?           // Auto-linked from parents if possible
  secondaryBreedDNA String?
  healthStatus      String            @default("Excellent")
  vaccinations      VaccinationType[]
  healthClearances  HealthClearance[]
  healthNotes       String?           @db.Text
  DNAdocuments      Document[]        @relation("CanineDocuments")

  // Relations
  ownerId           String
  owner             User              @relation("UserCanines", fields: [ownerId], references: [id])

  // Link to Birth Litter
  litterId          String?
  litter            Litter?           @relation("LitterPuppies", fields: [litterId], references: [id], onDelete: Cascade)

  // Pedigree Tree (When this canine becomes a parent)
  asMother          Litter[]          @relation("MotherRelation")
  asFather          Litter[]          @relation("FatherRelation")

  // Baki Relations
  images            Image[]           @relation("CanineImages")
  transfers         OwnershipTransfer[] @relation("CanineTransfers")
  healthRequests    CanineHealthRequest[] @relation("CanineHealthRequests")
  reports           Report[]          @relation("CanineReports")
  certificateRequests CertificateRequest[] @relation("CanineCertRequests") 

  status            CanineStatus      @default(PENDING) 
  requestType       RegistrationRequestType @default(NEW_REGISTRATION)
  assignedTier      VerificationType  @default(NONE)  

  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  @@map("canines")
}

enum RegistryTier {
  GOLD
  BLUE
}

model PcrSequence {
  id        String   @id @default(uuid())
  kind      String   // 'CANINE' or 'LITTER' 
  prefix    String   // 'G', 'B', 'L'
  breedCode String   // '301', '119'
  lastValue Int      @default(0)

  @@unique([kind, prefix, breedCode])
  @@map("pcr_sequences")
}